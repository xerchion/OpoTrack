# Configuración local de OpoTrack. Copia este archivo como .env y pon TUS valores.
# NUNCA escribas valores reales en este .env.example (se sube a git).
# Reinicia la app tras editar el .env.

# Clave de sesión de Flask (opcional; si no la defines se genera una aleatoria
# en cada arranque). Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
# OPOTRACK_SECRET=

# --- Notificaciones por Telegram (avisos diarios de novedades) -----------
# Crea un bot con @BotFather y pega aquí su token. Tu chat_id lo obtienes
# escribiendo primero al bot y visitando luego (en el navegador):
#   https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# o preguntando a @userinfobot. Paso a paso en NOTIFICACIONES.md.
TELEGRAM_BOT_TOKEN=pon_aqui_el_token_de_tu_bot
TELEGRAM_CHAT_ID=pon_aqui_tu_chat_id
# Opcional: pon 1 para recibir también un aviso los días SIN novedades.
OPOTRACK_NOTIFICAR_SIN_NOVEDADES=0
# Opcional: 0 para NO recibir el 2º mensaje con los "no coincidentes" del día.
OPOTRACK_ENVIAR_NO_COINCIDENTES=1
# Opcional: máximo de "no coincidentes" por aviso (0 = sin tope).
OPOTRACK_MAX_NO_COINCIDENTES=200
